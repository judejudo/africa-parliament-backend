{
  "kind": "collectionType",
  "collectionName": "member_states",
  "info": {
    "singularName": "member-state",
    "pluralName": "member-states",
    "displayName": "Member State",
    "description": "African parliament member states with country name and flag"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "country": {
      "type": "string",
      "maxLength": 255,
      "required": true,
      "unique": true
    },
    "flag": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "publication": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::publication.publication",
      "mappedBy": "country"
    },
    "parliamentFlag": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    }
  }
}
